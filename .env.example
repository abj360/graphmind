# Neo4j connection (compose service name resolves inside the network)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphmind-dev
NEO4J_DATABASE=neo4j

# LLM provider for extraction
OPENAI_API_KEY=sk-change-me
GRAPHMIND_EXTRACT_MODEL=gpt-4o-mini

# Extraction tuning
GRAPHMIND_EXTRACT_BATCH_SIZE=8
GRAPHMIND_EXTRACT_MAX_RETRIES=2
GRAPHMIND_EXTRACT_MIN_CONFIDENCE=0.0
GRAPHMIND_EXTRACT_REQUIRE_SPAN=false
